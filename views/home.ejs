<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900">
        <div class="form p-10 text-white">
            <form action="/create" method="post">
                <input type="text" name="title" placeholder="Title goes here..." class="block w-full rounded-md m-2 outline-none px-5 py-2 bg-zinc-800"/>
                <input placeholder="Description" name="desc" class="block w-full rounded-md outline-none m-2 px-5 py-2 bg-zinc-800 resize-none">
                <button type="submit" class="m-2 p-2 rounded-lg bg-blue-600">Create Task</button>
            </form>
        </div>
        <div class="tasks flex gap-3 flex-wrap p-10">
        <% if(files.length>0){%>
            <% files.forEach((val)=>{ %>
                    <div class="task min-w-72 px-3 py-4 rounded-md bg-zinc-800">
                        <h1 class="text-white text-3xl tracking tighter"><%= val %></h1>
                        <div class="flex justify-between">
                            <a class="text-blue-500 inline-block mt-3" href="./files/<%= val %>">Read More</a>
                            <a class="text-zinc-600 inline-block mt-3" href="./edit/<%= val %>">Edit filename</a>
                        </div>
                    </div>
                <%})%>
        <%} else {%>
            <h3 class="text-zinc-600">No Tasks yet.</h3>
        <%}%>
        </div>
    </div>
</body>
</html>